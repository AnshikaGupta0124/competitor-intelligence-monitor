    {
      "parameters": {
        "jsCode": "const todayItems = $('Code in JavaScript').all();\n\nconst todayMap = {};\ntodayItems.forEach(item => {\n    const name = item.json.competitor || 'Unknown';\n    todayMap[name] = item.json.cleanedContent || '';\n});\n\nreturn items.map(item => {\n    const fields = item.json.fields || item.json || {};\n    const competitor = fields.competitor || 'Unknown';\n    const yesterdayContent = (fields.cleanedContent || 'No previous data').substring(0, 1500);\n    const todayContent = (todayMap[competitor] || 'No data for today').substring(0, 1500);\n\n    const body = JSON.stringify({\n        model: \"llama-3.3-70b-versatile\",\n        messages: [{\n            role: \"user\",\n            content: `You are a competitor intelligence analyst for a Figma-like design tool company.\\n\\nCOMPETITOR: ${competitor}\\n\\nYESTERDAY'S CONTENT:\\n${yesterdayContent}\\n\\nTODAY'S CONTENT:\\n${todayContent}\\n\\nWhat CHANGED between yesterday and today?\\n1) New or changed pricing\\n2) New features announced\\n3) Any other changes\\n\\nIf nothing changed say \"No changes detected\". Be concise with bullet points.`\n        }],\n        max_tokens: 500\n    });\n\n    return {\n        json: {\n            competitor: competitor,\n            groqBody: body\n        }\n    };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1456, 0],
      "id": "92b443e9-b908-4a43-8e98-62a584a3b608",
      "name": "Code in JavaScript1",
      "executeOnce": false
    },
    {
      "parameters": {
        "jsCode": "const groqPrepItems = $('Code in JavaScript1').all();\n\nconst analyses = items.map((item, index) => {\n    const competitor = groqPrepItems[index]?.json?.competitor || 'Unknown';\n    let content = item.json.choices?.[0]?.message?.content || 'No analysis available';\n    content = content\n        .replace(/\\*\\*/g, '')\n        .replace(/\\*/g, '•')\n        .replace(/#{1,6} /g, '')\n        .trim();\n    return `🏢 ${competitor}\\n${'─'.repeat(40)}\\n${content}`;\n});\n\nconst emailBody = `COMPETITOR INTELLIGENCE DIGEST\\n${new Date().toDateString()}\\n${'═'.repeat(50)}\\n\\n${analyses.join('\\n\\n')}\\n\\n${'═'.repeat(50)}\\nPowered by your Competitor Intelligence Monitor`;\n\nreturn [{\n    json: {\n        subject: `Competitor Intelligence Digest - ${new Date().toDateString()}`,\n        body: emailBody\n    }\n}];"
      },
