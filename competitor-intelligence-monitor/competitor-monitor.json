    {
      "parameters": {
        "jsCode": "const splitItems = $('Split Out').all();\n\nreturn items.map((item, index) => {\n    let html = item.json.data || item.json.body || '';\n    \n    if (typeof html !== 'string') {\n        html = JSON.stringify(html);\n    }\n\n    let cleaned = html\n        .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n        .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n        .replace(/<head[\\s\\S]*?<\\/head>/gi, '')\n        .replace(/<!--[\\s\\S]*?-->/gi, '')\n        .replace(/<[^>]+>/g, '\\n')\n        .replace(/&nbsp;/g, ' ')\n        .replace(/&amp;/g, '&')\n        .replace(/&lt;/g, '<')\n        .replace(/&gt;/g, '>')\n        .replace(/\\s+/g, ' ')\n        .trim();\n\n    const lines = cleaned.split('\\n').filter(line => {\n        const trimmed = line.trim();\n        return trimmed.length > 15 &&\n               !trimmed.match(/^(javascript|css|data-|scroll|nav|header|footer|cookie)/i) &&\n               !trimmed.match(/^\\d+$/);\n    });\n\n    cleaned = lines.join('\\n').substring(0, 15000);\n\n    const meta = splitItems[index] ? splitItems[index].json : {};\n\n    return {\n        json: {\n            competitor: meta.competitor || 'Unknown',\n            pageType:   meta.pageType || 'Pricing',\n            url:        meta.url || '',\n            scrapedAt:  new Date().toISOString(),\n            cleanedContent: cleaned\n        }\n    };\n});"
      },
